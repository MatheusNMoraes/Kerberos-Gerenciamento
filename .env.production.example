DEBUG=False
DJANGO_SECRET_KEY=replace-this-with-a-generated-secret-key
ALLOWED_HOSTS=petshop.example.com
CSRF_TRUSTED_ORIGINS=https://petshop.example.com

POSTGRES_DB=famapet
POSTGRES_USER=famapet
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Fama Pet <noreply@example.com>

SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
